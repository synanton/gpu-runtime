# GPU-7 secrets template — copy to .env and fill in. .env is git-ignored; never commit it.
# Generate strong values, e.g.: openssl rand -hex 32

POSTGRES_PASSWORD=

# API key the Gateway uses to authenticate to the mock provider (any non-empty string;
# the mock validates it). Proves the credential path without a real provider account.
MOCK_PROVIDER_API_KEY=

# Optional: real external OpenAI provider arm (served by the generic
# OpenAI-compatible provider runtime; used by the platform benchmark's opt-in
# text-embedding-3-small comparison). Leave empty to run mock-only.
OPENAI_API_KEY=
