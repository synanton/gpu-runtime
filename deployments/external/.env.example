# GPU-7 secrets and provider switches: copy to .env and fill in. .env is git-ignored; never commit it.
# Generate strong values, e.g.: openssl rand -hex 32
#
# The gateway reads this file via compose `env_file`. A variable that is present but EMPTY
# overrides the default in config/gateway-external.yaml with "". So comment out any optional
# line you don't set, rather than leaving `NAME=`.

POSTGRES_PASSWORD=

# API key the Gateway uses to authenticate to the mock provider (any non-empty string;
# the mock validates it). Proves the credential path without a real provider account.
MOCK_PROVIDER_API_KEY=

# ─── External provider arms ─────────────────────────────────────────────────────
# Switch arms on/off here; keys and model IDs stay configured even when an arm is off.
# GPU7_EXTERNAL_PROVIDER selects the arm tools/gpu7-check validates (openrouter | opencode).
GPU7_EXTERNAL_PROVIDER=opencode

# OpenRouter (provider id `openai`): FREE models only (allowed-model-pattern ".*:free").
# Also serves the retrieval-benchmark EMBED arms. opencode.ai has no embeddings.
OPENAI_PROVIDER_ENABLED=false
OPENAI_API_KEY=
# OPENROUTER_CHAT_MODEL=liquid/lfm-2.5-2.6b:free
# OPENROUTER_CHAT_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_RESPONSES_MODEL=liquid/lfm-2.5-2.6b:free
# OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
# OPENROUTER_EMBED_VL_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# OPENROUTER_EMBED_LFM_MODEL=liquid/lfm-2.5-embedding-350m:free

# opencode.ai Zen (provider id `opencode`), https://opencode.ai/zen/v1: chat completions and
# the Responses API. No embeddings or rerank. Its free tier (*-free, big-pickle) is refused
# outside the OpenCode app, so the defaults are the cheapest working PAID models. Prices
# (USD per million tokens) feed the cost ledger and budget, so keep them in line with
# https://opencode.ai/zen pricing.
OPENCODE_PROVIDER_ENABLED=true
OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_USER_AGENT=synanton/1.0 (Synthesis & Semantics App)
# OPENCODE_CHAT_MODEL=qwen3.8-flash
# OPENCODE_CHAT_FALLBACK_MODEL=glm-5.3-flash
# OPENCODE_CHAT_INPUT_USD_PER_M=0.15
# OPENCODE_CHAT_OUTPUT_USD_PER_M=0.50
# OPENCODE_RESPONSES_MODEL=gpt-6-luna
# OPENCODE_RESPONSES_INPUT_USD_PER_M=0.10
# OPENCODE_RESPONSES_OUTPUT_USD_PER_M=0.50
# Spend guard: startup fails unless every opencode catalog model matches this regex.
# OPENCODE_ALLOWED_MODEL_PATTERN=qwen3.8-flash|glm-5.3-flash|gpt-6-luna|jev-1.13|.*-free

# Budgets (USD per UTC day, from the cost ledger)
# GPU7_DEFAULT_DAILY_USD=5.00
# GPU7_SMOKE_DAILY_USD=0.05
