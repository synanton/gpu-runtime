# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# IDE
.idea/
*.iws
*.iml
*.ipr
.vscode/

# macOS
.DS_Store

# Environment
.env
.env.local

# Protobuf generated sources (regenerated by Gradle)
**/generated/

.claude/**/*.json

# Python virtualenvs (tools/gpu7-check uses a uv venv)
.venv/
__pycache__/

# TLS material generated by scripts/gen-certs.sh — never commit keys
deployments/**/certs/
*.key
/git-ignored/
